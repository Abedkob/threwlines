DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/threwlines
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Local file uploads are stored here (defaults to ./data/uploads).
# UPLOAD_DIR=./data/uploads

# Licensing API signing keys. Generate with: node scripts/generate-license-signing-keys.mjs
LICENSE_SIGNING_KEY_ID=threwlines-license-1
LICENSE_SIGNING_PRIVATE_JWK=
LICENSE_SIGNING_PUBLIC_JWK=

# Comma-separated origins allowed to call the public licensing API.
LICENSE_ALLOWED_ORIGINS=https://your-app.example
