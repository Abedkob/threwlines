# ================================================================
# threwlines — production environment template for Dokploy
# Paste these into the Dokploy Application → Environment panel.
# Do NOT commit filled-in values; this file carries only placeholders.
# ================================================================

# ---- Database ----
# Use the connection string Dokploy prints for the Postgres service.
# Format: postgres://<user>:<password>@<service-name>:5432/<db>
# Inside Dokploy, services on the same project resolve by their service name.
DATABASE_URL=postgres://vault:REPLACE_ME@threwlines-db:5432/threwlines

# ---- Session JWT ----
# Generate a long random secret and keep it stable (rotating logs everyone out):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM_SECRET

# ---- Local file storage ----
# The Dockerfile sets this to /data/uploads. Mount a Dokploy volume at /data.
UPLOAD_DIR=/data/uploads

# ---- Licensing signing keys ----
# Generate ONCE for production (do not reuse the dev keys). From inside the repo:
#   node scripts/generate-license-signing-keys.mjs
# Keep the PRIVATE JWK secret. The PUBLIC JWK is what third-party apps verify
# against via /api/license/v1/.well-known/jwks.json.
LICENSE_SIGNING_KEY_ID=threwlines-license-1
LICENSE_SIGNING_PRIVATE_JWK=REPLACE_WITH_PRIVATE_JWK_JSON
LICENSE_SIGNING_PUBLIC_JWK=REPLACE_WITH_PUBLIC_JWK_JSON

# ---- CORS allow-list ----
# Comma-separated exact origins that may call the licensing API from a browser.
# Do NOT use "*" in production — the CORS layer fails closed.
LICENSE_ALLOWED_ORIGINS=https://your-licensed-app.example.com

# ---- Reverse proxy ----
# Dokploy fronts the app with Traefik, which sets X-Forwarded-For.
# Setting this to "true" lets the licensing rate limiter trust that header.
LICENSE_TRUSTED_PROXY=true
